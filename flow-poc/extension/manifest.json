{
  "name": "Mockup Studio Flow Bridge",
  "version": "0.1.0",
  "manifest_version": 3,
  "description": "Native messaging bridge for Google Flow integration",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://flow.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "downloads",
    "downloads.open",
    "debugger",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://flow.google.com/*"
  ],
  "externally_connectable": {
    "matches": ["*://flow.google.com/*"]
  }
}
